{
  "name": "app-http",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/app-http/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/app-http",
        "main": "libs/app-http/src/index.ts",
        "tsConfig": "libs/app-http/tsconfig.lib.json",
        "assets": [
          {
            "input": "{workspaceRoot}",
            "glob": "LICENSE",
            "output": "."
          },
          {
            "input": "libs/app-http",
            "glob": "README.md",
            "output": "."
          }
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "command": "vitest run",
        "cwd": "libs/app-http"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "tsc -p tsconfig.lib.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "cwd": "libs/app-http",
        "parallel": true
      }
    }
  }
}
