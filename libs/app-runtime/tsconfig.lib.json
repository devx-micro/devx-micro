{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // No maps: sources are not published, and on Windows the build wrote this machine's absolute
    // paths into them.
    "sourceMap": false,
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
