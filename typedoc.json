{
  "$schema": "https://typedoc.org/schema.json",
  "name": "devx-micro API",
  "entryPointStrategy": "packages",
  "entryPoints": ["libs/*"],
  "readme": "README.md",
  "out": "docs/api",
  "excludePrivate": true,
  "excludeInternal": true,
  "navigationLinks": {
    "GitHub": "https://github.com/devx-micro/devx-micro"
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  }
}
