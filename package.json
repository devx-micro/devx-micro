{
  "name": "@devx-micro/workspace",
  "private": true,
  "version": "0.0.0",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.16"
  },
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "lint": "nx run-many -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nx/eslint": "^24.0.6",
    "@nx/eslint-plugin": "^24.0.6",
    "@nx/js": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "jsonc-eslint-parser": "^2.4.2",
    "nx": "24.0.6",
    "prettier": "~3.6.2",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/cqrs": "^11.0.3",
    "mdast-util-from-markdown": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "esbuild@0.28.2": true,
    "nx@24.0.6": true
  }
}
