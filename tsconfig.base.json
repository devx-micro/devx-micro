{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "paths": {
      "@devx-micro/observability-port": [
        "./libs/observability-port/src/index.ts"
      ],
      "@devx-micro/cqrs-tool-runtime": [
        "./libs/cqrs-tool-runtime/src/index.ts"
      ],
      "@devx-micro/cqrs-http-transport": [
        "./libs/cqrs-http-transport/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "tmp"
  ]
}
