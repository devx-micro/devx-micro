{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "paths": {
      "@devx-micro/app-observability": [
        "./libs/app-observability/src/index.ts"
      ],
      "@devx-micro/app-runtime": [
        "./libs/app-runtime/src/index.ts"
      ],
      "@devx-micro/app-http": [
        "./libs/app-http/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "dist", "tmp"]
}
